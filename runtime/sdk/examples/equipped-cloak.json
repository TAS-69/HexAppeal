        {"id": "black", "label": "Black", "prefab": "example_cloak_emberglass_black"},
        {"id": "jade", "label": "Jade", "prefab": "example_cloak_emberglass_jade"}
      ]
    },
    {
      "id": "visible",
      "label": "Show cloak",
      "help": "Keeps the cloak equipped when hidden.",
      "type": "toggle",
      "default": true,
      "follow_outfit_hide": true
    }
  ]
}
